debug:
  cpu: false
  fps: false
  gpu: false
  gte: false
  spu_ram: false
default_scene_script_parent: null
default_sound_bank: null
editor_version: 0.8.0
format_version: 1
lua_execution: native_cpp
lua_profile: gameplay_v2
name: Controller Rumble
play:
  content: whole_game
  data: executable
  initial_scene: null
  runtime: play_station
  selected_scenes: []
  target: serial
rendering:
  dither_3d: false
  exact_near_clipping: true
  geometry_draw_distance: 128
  gte_depth_average: true
  height: 480
  motion_interpolation: true
  precomputed_visibility: false
  retained_geometry: true
  sprite_triangle_budget: 2048
  streaming_geometry: false
  streaming_pool_pages: 4
  streaming_prefetch: true
  streaming_triangle_budget: 4096
  width: 640
startup_scene: assets/scenes/Main.epokmap
transition:
  fade_in_ms: 300
  fade_out_ms: 300
  image: null
  text: Now loading...
