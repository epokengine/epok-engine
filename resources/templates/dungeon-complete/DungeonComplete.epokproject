    name: Keyboard & Mouse
debug:
  cpu: false
  fps: false
  gpu: false
  gte: false
  spu_ram: false
default_scene_script_parent: null
default_sound_bank: 1e494766-8cf6-495b-8f6a-a8e27b027f42
editor_version: 0.9.0
format_version: 1
lua_execution: native_cpp
lua_profile: gameplay_v2
name: Dungeon Complete
play:
  analog_controller: true
  content: current_scene
  data: host
  initial_scene: null
  runtime: play_station
  selected_scenes: []
  target: embedded
rendering:
  dither_3d: false
  exact_near_clipping: true
  geometry_draw_distance: 128
  gte_depth_average: true
  height: 240
  mesh_triangle_budget: 2432
  motion_interpolation: true
  precomputed_visibility: true
  retained_geometry: true
  sprite_triangle_budget: 128
  streaming_geometry: true
  streaming_pool_pages: 2
  streaming_prefetch: true
  streaming_triangle_budget: 2432
  width: 320
scene_storage:
  in_executable:
  - assets/scenes/DungeonGame.epokmap
startup_scene: assets/scenes/DungeonGame.epokmap
transition:
  fade_in_ms: 300
  fade_out_ms: 300
  image: null
  text: Now loading...
